# Copy to .env and fill in. Never commit the real file.

# DeepSeek inference backend (Stage 0/1)
DEEPSEEK_API_KEY=

# Optional: override the OpenAI-compatible endpoint
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Live tests are opt-in and must never run in the default suite.
ATLASOS_RUN_LIVE_TESTS=0

# Bounded budget for live tests (tokens), enforced by the live test itself.
ATLASOS_LIVE_MAX_PROMPT_TOKENS=4000

# Atlas Sandbox defaults to a self-hosted OpenSandbox server. No external cloud credential is
# required. If the local server is configured with server.api_key, set the same local service key:
# OPEN_SANDBOX_API_KEY=

# Optional non-default backend: Daytona. It is not used by the default UAT configuration.
# DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=
# DAYTONA_JWT_TOKEN=
# DAYTONA_ORGANIZATION_ID=
